# Copy this file to .env and fill in the real values.
# .env is gitignored and must NEVER be committed.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL 17 is on port 5432, PostgreSQL 18 is on 5433 on this machine.
POSTGRES_DB=digibank
POSTGRES_USER=digibank
POSTGRES_PASSWORD=put-the-password-you-choose-here
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Comma separated. Leave blank in development (DEBUG allows all origins).
CORS_ALLOWED_ORIGINS=

# Business rules
OTP_LENGTH=6
OTP_VALIDITY_MINUTES=5
OTP_MAX_ATTEMPTS=5
EMERGENCY_REQUEST_VALIDITY_HOURS=48
BIOMETRIC_CHALLENGE_VALIDITY_SECONDS=120


# ---------------------------------------------------------------------------
# OTP delivery
# ---------------------------------------------------------------------------
# auto    = email when EMAIL_HOST_USER is set, otherwise print to the console
# console = print the code in the runserver terminal (no delivery)
# email   = real email over SMTP
# sms     = real SMS (needs SMS_* below and `pip install twilio`)
OTP_DELIVERY_CHANNEL=auto
OTP_RESEND_COOLDOWN_SECONDS=30

# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters below.
# Your normal Gmail password will NOT work.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Optional real SMS. Leave blank unless you have a provider account.
SMS_PROVIDER=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# Refresh-token cookie. Keep SECURE False on plain-HTTP localhost or the
# browser drops the cookie and login silently fails.
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=Lax

# Where the React dev server runs. Must be exact - credentials cannot use "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used only by setup_db.py, to create the role/database once.
POSTGRES_SUPERUSER=postgres

# Which database is live: sqlite | postgres
# sqlite needs no role, password or server - good for a first run.
DB_ENGINE=postgres

# --- Payments (Razorpay) ----------------------------------------------------
# Test keys (rzp_test_...) run the full checkout with test UPI/cards, no real
# money. Live keys (rzp_live_...) need an activated Razorpay merchant account.
# Leave both empty in development to use the simulated top-up (DEBUG only).
PAYMENT_PROVIDER=auto
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks: URL https://<domain>/api/payments/razorpay/webhook/
# events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=

# --- KYC ---------------------------------------------------------------------
# Encrypts PAN numbers at rest. Generate once and never change it:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Where KYC documents are stored (never served publicly)
# PRIVATE_MEDIA_ROOT=/var/digibank/private_media

# --- Biometric sign-in (WebAuthn) -------------------------------------------
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:5173
