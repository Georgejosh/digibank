# Copy to .env.local (git-ignored) and adjust per developer.

# In development leave this as the relative path "/api": the Vite dev server
# proxies it to Django, so the browser sees one origin and the httpOnly refresh
# cookie is first-party. A full cross-origin URL here will break silent refresh
# unless you also serve everything over HTTPS with SameSite=None.
# In production, point it at wherever the API is served from.
VITE_API_BASE_URL=/api

# Where the dev proxy forwards to. Only needed if Django is not on port 8000.
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# "true" serves every request from src/services/mockApi.js with no backend.
VITE_USE_MOCK_API=false
